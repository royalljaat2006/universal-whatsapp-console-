# Single entrypoint: the browser, Meta's webhook calls and WebSockets all hit
# nginx. Same-origin routing means session cookies work without CORS.
#
#   ${BASE_PATH}/api/  /admin/  /static/  -> backend (Django, ASGI)
#   ${BASE_PATH}/webhooks/                -> backend (raw body preserved for HMAC)
#   ${BASE_PATH}/ws/                      -> backend (WebSocket upgrade)
#   ${BASE_PATH}/health/                  -> backend
#   everything else under ${BASE_PATH}/   -> frontend (Next.js)
#
# BASE_PATH is empty in local development (paths at the root, as documented
# above) and set to a subpath (e.g. "/whatsapp-console") only when this stack
# is reverse-proxied under a path prefix by an outer gateway that does NOT
# strip the prefix — see docs/deployment.md. This file is a template:
# `envsubst '$BASE_PATH'` renders it to nginx.conf at container start
# (docker-entrypoint.sh in the nginx service command), touching only the
# literal $BASE_PATH token and leaving every nginx runtime variable
# ($scheme, $host, ...) untouched.

worker_processes auto;
events { worker_connections 1024; }

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;
  server_tokens off;
  sendfile      on;
  keepalive_timeout 65;

  # Correlation id: reuse the client's if present, else nginx's own.
  map $http_x_request_id $req_id {
    default   $http_x_request_id;
    ""        $request_id;
  }

  map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
  }

  # Trust an already-set X-Forwarded-Proto from an outer reverse proxy (this
  # stack may itself be proxied, e.g. behind a shared gateway terminating
  # TLS); fall back to this connection's own scheme when nothing set it
  # (local development, or nginx as the origin).
  map $http_x_forwarded_proto $inbound_scheme {
    default $http_x_forwarded_proto;
    ""      $scheme;
  }

  log_format json escape=json '{"ts":"$time_iso8601","request_id":"$req_id","remote":"$remote_addr",'
                              '"method":"$request_method","uri":"$uri","status":$status,'
                              '"bytes":$body_bytes_sent,"duration_s":$request_time,'
                              '"upstream_s":"$upstream_response_time"}';
  access_log /dev/stdout json;
  error_log  /dev/stderr warn;

  # Re-resolve service names (Docker DNS) so a restarted container with a new
  # IP does not leave nginx pointing at a dead address (502s).
  resolver 127.0.0.11 valid=10s ipv6=off;
  upstream backend  { zone backend 64k;  server backend:8000 resolve;  keepalive 16; }
  upstream frontend { zone frontend 64k; server frontend:3000 resolve; keepalive 16; }

  # Webhook flood protection (per source IP). Meta batches deliveries, so a
  # generous burst is allowed; tune with real traffic data.
  limit_req_zone $binary_remote_addr zone=webhooks:10m rate=50r/s;

  server {
    listen 80;
    client_max_body_size 4m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $inbound_scheme;
    proxy_set_header X-Request-ID      $req_id;
    proxy_set_header Connection        "";

    location ${BASE_PATH}/webhooks/ {
      limit_req zone=webhooks burst=200 nodelay;
      proxy_request_buffering on;
      proxy_read_timeout 15s;
      proxy_pass http://backend/webhooks/;
    }

    location ${BASE_PATH}/ws/ {
      proxy_set_header Upgrade    $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 3600s;
      proxy_pass http://backend/ws/;
    }

    # Media uploads: WhatsApp documents may be up to 100 MB (validated again in Django).
    location = ${BASE_PATH}/api/v1/media/ {
      client_max_body_size 101m;
      proxy_request_buffering on;
      proxy_read_timeout 120s;
      proxy_pass http://backend/api/v1/media/;
    }

    location ~ ^${BASE_PATH}/(api|admin|static|health)/(.*)$ {
      proxy_read_timeout 60s;
      proxy_pass http://backend/$1/$2$is_args$args;
    }

    location ${BASE_PATH}/ {
      proxy_set_header Upgrade    $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_pass http://frontend;
    }
  }
}
