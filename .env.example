# =============================================================================
# WhatsApp Platform — environment template
# Copy to `.env` for local development. NEVER commit a real `.env`.
# Every value below is a placeholder. Production values come from the
# deployment's secret store, not from this file.
# =============================================================================

# --- Runtime environment -----------------------------------------------------
# development | staging | production
APP_ENV=development
DJANGO_SETTINGS_MODULE=config.settings.development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-dev-only-insecure-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Origins allowed to POST with CSRF (the nginx entrypoint in local dev)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console

# Bearer token for GET /metrics (Prometheus scrape target). Leave blank to
# keep the endpoint disabled (404) — set it only once you have a Prometheus
# configured to scrape this app. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=whatsapp_platform
POSTGRES_USER=whatsapp_platform
POSTGRES_PASSWORD=change-me-dev-only
DATABASE_URL=postgres://whatsapp_platform:change-me-dev-only@postgres:5432/whatsapp_platform
DATABASE_CONN_MAX_AGE=60

# --- Redis (separate logical DBs per concern) --------------------------------
REDIS_CACHE_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CHANNELS_REDIS_URL=redis://redis:6379/2
RATE_LIMIT_REDIS_URL=redis://redis:6379/3

# --- Meta WhatsApp Cloud API -------------------------------------------------
# Graph API version is configured in ONE place. Verified current: v26.0
# (see docs/integrations/meta/api-assumptions.md before changing).
META_GRAPH_API_VERSION=v26.0
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_HTTP_TIMEOUT_SECONDS=15
META_APP_ID=
# Used ONLY to validate X-Hub-Signature-256 on inbound webhooks, and as the
# client_secret when exchanging an Embedded Signup code for a token. Secret.
META_APP_SECRET=
# A random string you invent and paste into the Meta App Dashboard. Secret.
META_WEBHOOK_VERIFY_TOKEN=
# Facebook Login for Business configuration id for Embedded Signup (App
# Dashboard > Facebook Login for Business > Configurations). Not secret.
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Default credential reference used when connecting a WABA from the CLI.
# Format: env:<VARIABLE_NAME>. Only variables prefixed PROVIDER_SECRET_ may
# be referenced (prevents tenants from reading arbitrary env vars).
META_ACCESS_TOKEN_REFERENCE=env:PROVIDER_SECRET_META_SYSTEM_USER_TOKEN
# The System User access token itself. Secret. Leave blank until provisioned.
PROVIDER_SECRET_META_SYSTEM_USER_TOKEN=

# --- Encryption at rest for DB-stored credentials ----------------------------
# Comma-separated Fernet keys; the FIRST key encrypts, all keys decrypt
# (enables rotation). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

# --- Webhooks ----------------------------------------------------------------
WEBHOOK_MAX_BODY_BYTES=3145728
WEBHOOK_MAX_PROCESSING_ATTEMPTS=8

# --- Retention (days; 0 = keep forever; nothing is deleted automatically
# until a retention job is explicitly enabled — see docs/security.md) ---------
RETENTION_WEBHOOK_EVENTS_DAYS=90
RETENTION_AUDIT_LOGS_DAYS=0
RETENTION_ENABLED=false

# --- Database backups (infrastructure/docker/backup) ------------------------
# Daily/weekly/monthly tiered retention (see docs/deployment.md#backups).
BACKUP_INTERVAL_SECONDS=86400
BACKUP_DAILY_RETENTION_DAYS=7
BACKUP_WEEKLY_RETENTION_WEEKS=4
BACKUP_MONTHLY_RETENTION_MONTHS=6
# A failed cycle is retried this many times (e.g. database still starting).
BACKUP_RETRY_ATTEMPTS=3
BACKUP_RETRY_DELAY_SECONDS=60
# Passphrase backups are encrypted with (openssl aes-256-cbc). Left blank,
# backups are stored UNENCRYPTED (with a warning in the backup service's
# logs) — never invented for you. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Store this somewhere other than this repo's .env alone (a password
# manager or secret store) — losing it makes every encrypted backup
# unrecoverable.
BACKUP_ENCRYPTION_KEY=

# --- Transactional email (password reset, email verification, invites) -----
# Defaults to logging emails to the console — no provider chosen yet. Point
# at django.core.mail.backends.smtp.EmailBackend + the EMAIL_HOST_* vars
# below once one is; no code changes needed anywhere else.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
# Secret. For temporary personal Gmail SMTP: a Gmail *App Password* (Google
# Account > Security > 2-Step Verification > App passwords), NEVER your real
# account password — Gmail rejects normal passwords for SMTP AUTH once
# 2-Step Verification is on, which is required to generate an App Password.
# Example for Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587,
# EMAIL_USE_TLS=true, EMAIL_HOST_USER=you@gmail.com,
# EMAIL_HOST_PASSWORD=<16-character App Password, no spaces>.
# Switching to a company mailbox later is the same four vars, no code change.
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Seconds for each SMTP connect/read; keeps a stalled provider from blocking a worker.
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=no-reply@example.com
# Absolute origin (+ subpath mount point) used only in email bodies, where a
# relative path can't work. No trailing slash.
PUBLIC_BASE_URL=http://localhost:8080

# --- Frontend (server-side only; never NEXT_PUBLIC_ for secrets) -------------
# Used by Next.js dev-server rewrites when running outside nginx.
BACKEND_INTERNAL_URL=http://backend:8000

# --- Frontend (client-visible; baked into the build, not secret) ------------
# Shown as "Contact support" in the console's Help & Support menu. Leave
# blank to show "not configured yet" instead of a broken mailto: link.
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Two-step verification (TOTP) ------------------------------------------
# Opt-in per user. When true, platform staff (is_staff) MUST have enrolled to
# use /api/v1/platform/*. Leave false until every operator has enrolled
# (docs/security.md#two-step-verification-totp).
MFA_REQUIRED_FOR_STAFF=false
MFA_ISSUER=WhatsApp Console

# --- Per-organization operational safeguards (0 disables) -------------------
MAX_ACTIVE_API_KEYS_PER_ORG=50
MAX_PENDING_INVITATIONS_PER_ORG=100
MAX_ACTIVE_EXPORTS_PER_ORG=5
